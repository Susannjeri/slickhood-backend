# Database
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Browser application origin. Production: https://app.slickhood.com
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
LOGIN_ATTEMPT_WINDOW_MINUTES=15

# Paystack test mode. Use only sk_test_... here while testing.
PAYSTACK_ENABLED=true
PAYSTACK_SECRET_KEY=
PAYSTACK_API_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=http://localhost:3000/payment/callback
PAYSTACK_CURRENCY=KES
PAYSTACK_CHANNELS=card,mobile_money
PAYSTACK_FEE_BEARER=subaccount

# Signed payment callbacks
FLUTTERWAVE_WEBHOOK_SECRET=
MPESA_CALLBACK_TOKEN=

# WhatsApp Cloud API. The verify token must be a long deployment secret.
WHATSAPP_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONENUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# S3-compatible object storage. Disable only in isolated tests where uploads are not exercised.
GARAGE_S3_ACCESS_KEY=
GARAGE_S3_SECRET_KEY=
GARAGE_S3_URL=http://127.0.0.1:3900
GARAGE_PRESIGNER_URL=http://127.0.0.1:3900
GARAGE_S3_BUCKET=slickhood-bucket
GARAGE_BOOTSTRAP_ENABLED=true

# Optional IP geolocation enrichment. Requires a valid MaxMind licence when enabled.
GEOLITE_ENABLED=true
GEOLITE_LICENSE_KEY=

# Application encryption key store.
SERVER_SSL_KEY_STORE=
SERVER_SSL_KEY_STORE_PASSWORD=
SERVER_SSL_KEY_STORE_TYPE=PKCS12
SERVER_SSL_KEY_STORE_KEY_ALIAS=


OPENAI_API_KEY=
OPENAI_HELPDESK_MODEL=gpt-5-mini
HELPDESK_AI_BASE_URL=https://api.openai.com/v1
HELPDESK_AI_ENABLED=true
HELPDESK_AI_MAX_INPUT_CHARS=4000
HELPDESK_AI_MAX_CONTEXT_MESSAGES=12
HELPDESK_AI_CONNECT_TIMEOUT=PT3S
HELPDESK_AI_READ_TIMEOUT=PT20S
HELPDESK_GUEST_SESSION_HOURS=24
HELPDESK_RATE_LIMIT_PER_MINUTE=20
HELPDESK_GUEST_START_LIMIT_PER_MINUTE=10
HELPDESK_SLA_URGENT=PT15M
HELPDESK_SLA_HIGH=PT1H
HELPDESK_SLA_NORMAL=PT4H
HELPDESK_SLA_LOW=PT8H
HELPDESK_SLA_SCAN_DELAY_MS=60000

# Silverwood Insurance Agency correspondence. Use a dedicated monitored mailbox.
INSURANCE_MAIL_FROM=info@silverwoodinsurance.com
INSURANCE_REPLY_TO=info@silverwoodinsurance.com
INSURANCE_MAIL_DISPLAY_NAME=Silverwood Insurance Agency
INSURANCE_IMAP_HOST=mail.silverwoodinsurance.com
INSURANCE_IMAP_PORT=993
INSURANCE_IMAP_SSL=true
INSURANCE_IMAP_USERNAME=info@silverwoodinsurance.com
INSURANCE_IMAP_PASSWORD=
INSURANCE_IMAP_ENABLED=false

# Truehost/cPanel SMTP. Keep MAIL_PASSWORD only in the deployment secret store.
MAIL_HOST=mail.silverwoodinsurance.com
MAIL_PORT=465
MAIL_AUTH=true
MAIL_START_TLS=false
MAIL_SSL=true
MAIL_USERNAME=info@silverwoodinsurance.com
MAIL_PASSWORD=
