<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"/><title>Receipt {{receiptNumber}}</title>
<style>
@page{size:A4;margin:24mm}body{font-family:Arial,sans-serif;color:#162b63}.card{border:1px solid #dbe2ee;border-radius:14px;padding:28px}.brand{color:#ef4217;font-weight:700}.title{font-size:30px;font-weight:700;margin:18px 0 4px}.paid{display:inline-block;background:#e9f8ef;color:#16794a;border-radius:999px;padding:6px 12px;font-weight:700}.amount{font-size:28px;font-weight:700;margin:24px 0}.row{display:flex;justify-content:space-between;border-top:1px solid #edf0f5;padding:12px 0}.label{color:#718096}.value{font-weight:600;text-align:right}.note{margin-top:28px;color:#718096;font-size:12px}
</style></head><body><div class="card"><div class="brand">SlickHood</div><div class="title">Payment receipt</div><div class="paid">PAID</div><div class="amount">{{currency}} {{amount}}</div>
<div class="row"><span class="label">Receipt</span><span class="value">{{receiptNumber}}</span></div>
<div class="row"><span class="label">Invoice</span><span class="value">{{invoiceRef}}</span></div>
<div class="row"><span class="label">Provider reference</span><span class="value">{{providerReference}}</span></div>
<div class="row"><span class="label">Payment channel</span><span class="value">{{channel}}</span></div>
<div class="row"><span class="label">Paid by</span><span class="value">{{payer}}</span></div>
<div class="row"><span class="label">Paid to</span><span class="value">{{payee}}</span></div>
<div class="row"><span class="label">Payment date</span><span class="value">{{paidAt}}</span></div>
<p class="note">This receipt is generated from SlickHood's verified payment record. Keep the provider reference when requesting support or reconciliation.</p></div></body></html>
